# Server-only configuration. Never commit populated values or expose them to browser code.
# Node >=22: node --env-file=.env server/index.mjs
PORT=3000
HOST=127.0.0.1
# Durable local experiment state; ignored by git by default.
# SHOWONCE_DATA_FILE=/absolute/private/path/showonce-state.json
# SHOWONCE_ALLOWED_ORIGINS=https://your-authenticated-showonce-host

# VAST workshop API. Use existing authorized credentials; do not paste them into the UI.
INGRESS_URL=
# Supply a backend-issued token OR the existing workshop username/password.
VAST_API_TOKEN=
USERNAME=
PASSWORD=

# NVIDIA Cosmos endpoint. Model ID is discovered from /v1/models when omitted.
COSMOS3_REASON_URL=
COSMOS3_REASON_MODEL=
GPU_BEARER_TOKEN=

# Weights & Biases OpenAI-compatible inference.
# Set a deployed model ID explicitly; the app never guesses a current model name.
WANDB_API_KEY=
WANDB_MODEL=
WANDB_BASE_URL=https://api.inference.wandb.ai/v1
WANDB_TEAM=
WANDB_PROJECT=
